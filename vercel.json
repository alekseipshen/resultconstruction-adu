{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.resultconstruction.com/pre-approved",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
